<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SumiSetup</RootNamespace>
    <AssemblyName>SumiSetup</AssemblyName>
    <ApplicationIcon>..\..\assets\sumi.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Sumi</Product>
    <Description>Sumi Setup</Description>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PayloadDir>..\Sumi\bin\Release\net48\</PayloadDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="..\..\assets\sumi-256.png" LogicalName="art/icon.png" />
    <EmbeddedResource Include="$(PayloadDir)Sumi.exe;$(PayloadDir)Sumi.exe.config;$(PayloadDir)Microsoft.Web.WebView2.Core.dll;$(PayloadDir)Microsoft.Web.WebView2.WinForms.dll;$(PayloadDir)WebView2Loader.dll"
                      LogicalName="payload/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
